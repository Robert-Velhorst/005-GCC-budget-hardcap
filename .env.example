# Read-only planning is the default. Production execution requires every value marked REQUIRED.
PROJECT_ID=your-project-id
EXECUTION_MODE=plan
AUTOMATION_ENABLED=false

# REQUIRED for execute mode.
ALLOWED_BUDGET_NAMES=Production hardcap
EXPECTED_CURRENCY=EUR
ALLOWED_ZONES=europe-west4-a,europe-west4-b

BUDGET_LIMIT=10
THRESHOLD_RATIO=1
MANAGED_LABEL_KEY=budget-hardcap
MANAGED_LABEL_VALUE=true
PROTECTED_LABEL_KEY=budget-hardcap-protected
PROTECTED_LABEL_VALUE=true
EXCLUDED_INSTANCES=
MAX_ACTIONS_PER_EVENT=20
ACTION_DELAY_MS=250
OPERATION_TIMEOUT_SECONDS=180
OPERATION_POLL_INTERVAL_MS=2000
PROVIDER_REQUEST_TIMEOUT_MS=8000
COOLDOWN_SECONDS=300
MAX_EVENT_AGE_SECONDS=86400
EVENT_LEASE_SECONDS=600

# Recovery is opt-in and only applies to instances recorded as stopped by this service.
ENABLE_AUTOMATIC_RECOVERY=false
RECOVERY_DELAY_SECONDS=3600

FIRESTORE_DATABASE_ID=(default)
FIRESTORE_PREFIX=budgetHardcap
AUDIT_RETENTION_DAYS=90

# Local operator control plane. Loopback is the secure default.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
LOCAL_DATABASE_PATH=.runtime/budget-hardcap.db
PUBLIC_ACCESS_ENABLED=false
TRUST_PROXY=false
# Required for public/ngrok access. Use scripts/setup-local.ps1 to create a local secret file.
CONTROL_PLANE_TOKEN=
# Separate read-only token for the HAI MCP connector.
HAI_CONNECTOR_ENABLED=false
HAI_CONNECTOR_TOKEN=
NOTIFICATION_TOPIC=
