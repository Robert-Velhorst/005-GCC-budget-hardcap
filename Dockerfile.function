FROM node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe
ARG NPM_VERSION=12.2.1

ENV NODE_ENV=production
WORKDIR /app

COPY deploy/function/package.json deploy/function/package-lock.json ./
RUN npm install --global "npm@${NPM_VERSION}"
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY index.js ./
COPY src ./src

USER node
EXPOSE 8080
CMD ["node", "node_modules/@google-cloud/functions-framework/build/src/main.js", "--target=manageInstancesOnBudget", "--signature-type=cloudevent", "--port=8080"]
