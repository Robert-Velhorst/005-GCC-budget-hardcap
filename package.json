{
  "name": "gcc-budget-hardcap",
  "version": "3.0.0",
  "packageManager": "npm@12.2.1",
  "description": "Local and cloud control plane for fail-safe Google Cloud budget automation.",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "start": "functions-framework --target=manageInstancesOnBudget --signature-type=cloudevent",
    "start:health": "functions-framework --target=healthCheck --signature-type=http --port=8081",
    "start:control": "node src/control/main.js",
    "dev": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build:windows": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
    "preview:web": "vite preview --host 127.0.0.1",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test",
    "test:coverage": "c8 --check-coverage --lines 85 --functions 80 --branches 75 node --test",
    "smoke": "node scripts/smoke.js",
    "doctor": "node scripts/doctor.js",
    "reconcile": "node scripts/reconcile.js",
    "support:bundle": "node scripts/support-bundle.js",
    "verify": "npm run verify:sqlite && npm run lint && npm run test:coverage && npm run build:web && npm run smoke",
    "build:sqlite": "node scripts/build-sqlite.js",
    "verify:sqlite": "node scripts/verify-sqlite.js"
  },
  "keywords": [
    "google-cloud",
    "billing",
    "budget",
    "compute-engine",
    "cloud-functions"
  ],
  "license": "ISC",
  "dependencies": {
    "@google-cloud/firestore": "9.4.0",
    "@google-cloud/functions-framework": "5.0.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "google-auth-library": "11.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "c8": "12.0.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "node-gyp": "13.1.0"
  },
  "overrides": {
    "uuid": "14.0.3",
    "fast-uri": "4.2.3"
  }
}
